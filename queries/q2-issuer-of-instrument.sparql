# Q2: Who issues a given financial instrument?
# Bind ?instrument before running, e.g. to :AppleStock.

PREFIX : <https://froilan-sia.github.io/finance-ontology-rag/ontology#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

SELECT ?issuer ?name
WHERE {
    :AppleStock :issuedBy ?issuer .
    ?issuer rdfs:label ?name .
}
