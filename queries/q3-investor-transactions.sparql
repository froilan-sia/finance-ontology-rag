# Q3: What transactions has a given investor made?
# Bind ?investor before running, e.g. to :Alice.

PREFIX : <https://froilan-sia.github.io/finance-ontology-rag/ontology#>

SELECT ?investor ?account ?tx ?amount ?currency ?date
WHERE {
    :Alice a :Investor ;
           :hasAccount ?account .
    ?account :hasTransaction ?tx .
    ?tx :hasAmount ?amount ;
        :hasCurrency ?currency ;
        :hasDate ?date .
}
ORDER BY DESC(?date)
