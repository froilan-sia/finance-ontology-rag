@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix : <https://froilan-sia.github.io/finance-ontology-rag/ontology#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:FinancialInstrumentShape a sh:NodeShape ;
    sh:targetClass :FinancialInstrument ;
    sh:property [
        sh:path :hasISIN ;
        sh:minCount 1 ;
        sh:datatype xsd:string ;
        sh:pattern "^[A-Z]{2}[A-Z0-9]{9}[0-9]$" ;
    ] ;
    sh:property [
        sh:path :issuedBy ;
        sh:class :Issuer ;
        sh:minCount 1 ;
    ] .
